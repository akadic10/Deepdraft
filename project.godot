; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deepdraft"
run/main_scene="res://scenes/main/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CraftMaterials="*res://scripts/registries/CraftMaterials.gd"
SurfaceDetailRegistry="*res://scripts/registries/SurfaceDetailRegistry.gd"
ContentRegistry="*res://scripts/registries/ContentRegistry.gd"
BlockRegistry="*uid://darckb4wfswr6"
WorldClock="*uid://cntlqitntp144"
WorkFeedback="*res://scripts/systems/WorkFeedback.gd"
WorldData="*uid://cbq0ixpilwd48"
WorldGenerator="*uid://bl38ocrtbuj8s"
WaterManager="*res://scripts/systems/WaterManager.gd"
PlacedEntityRegistry="*res://scripts/registries/PlacedEntityRegistry.gd"
NavGrid="*res://scripts/systems/NavGrid.gd"
TaskManager="*res://scripts/systems/TaskManager.gd"
InteriorTracker="*res://scripts/systems/InteriorTracker.gd"
RoomManager="*res://scripts/systems/RoomManager.gd"
StockpileManager="*res://scripts/systems/StockpileManager.gd"
UIRegistry="*res://scripts/registries/UIRegistry.gd"
BlueprintLibrary="*res://scripts/systems/BlueprintLibrary.gd"
SkyController="*res://scripts/systems/SkyController.gd"
WeatherManager="*res://scripts/systems/WeatherManager.gd"
DwarfAssets="*res://scripts/registries/DwarfAssets.gd"
EventLog="*res://scripts/systems/EventLog.gd"
ColonyJournal="*res://scripts/systems/ColonyJournal.gd"
SaveManager="*res://scripts/systems/SaveManager.gd"
AmbientAudio="*res://scripts/systems/AmbientAudio.gd"
VideoSettings="*res://scripts/systems/VideoSettings.gd"
GameMenu="*res://scripts/ui/GameMenu.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=3

