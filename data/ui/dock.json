{
  "__comment": "Hearth & iron command navigation. UIRegistry owns this layout; action behavior lives in DockUI. Group order, labels and menu bindings are data.",
  "schema_version": 2,
  "items": [
    {
      "id": "orders",
      "label": "Orders",
      "icon": "res://assets/ui/icons/orders.svg",
      "tooltip": "Mining, chopping and cancelling work orders",
      "action": "open_panel",
      "target": "orders"
    },
    {
      "id": "zones",
      "label": "Zones",
      "icon": "res://assets/ui/icons/zones.svg",
      "tooltip": "Designate storage areas",
      "action": "open_panel",
      "target": "zones"
    },
    {
      "id": "rooms",
      "label": "Rooms",
      "icon": "res://assets/ui/icons/rooms.svg",
      "tooltip": "Inspect enclosed rooms, temperature and lighting",
      "action": "toggle_window",
      "target": "rooms"
    },
    {
      "id": "place",
      "label": "Place",
      "icon": "res://assets/ui/icons/place.svg",
      "tooltip": "Place finished furniture from colony stores",
      "action": "open_panel",
      "target": "place"
    },
    {
      "id": "colony",
      "label": "Colony",
      "icon": "res://assets/ui/icons/colony.svg",
      "tooltip": "Dwarves and settlement",
      "action": "open_panel",
      "target": "colony"
    },
    {
      "id": "stocks",
      "label": "Inventory",
      "icon": "res://assets/ui/icons/stocks.svg",
      "tooltip": "Browse colony supplies, check quantities and find items",
      "action": "open_panel",
      "target": "stocks"
    },
    {
      "id": "system",
      "label": "Menu",
      "icon": "res://assets/ui/icons/menu.svg",
      "tooltip": "Save, load and utilities",
      "action": "open_panel",
      "target": "system"
    }
