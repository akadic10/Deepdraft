  "menus": {
    "orders": {
      "title": "Orders",
      "items": [
        {
          "id": "mine",
          "label": "Mine blocks",
          "icon": "res://assets/ui/icons/orders.svg",
          "tooltip": "Drag to mark blocks. Shift + wheel changes width; Alt + wheel changes depth. Ctrl removes marks.",
          "action": "activate_tool",
          "target": "mine_precision"
        },
        {
          "id": "chop",
          "label": "Chop trees",
          "icon": "res://assets/ui/icons/chop.svg",
          "tooltip": "Click a tree or drag around several to mark them for felling.",
          "action": "activate_tool",
          "target": "chop"
        },
        {
          "id": "cancel",
          "label": "Cancel orders",
          "icon": "res://assets/ui/icons/cancel_orders.svg",
