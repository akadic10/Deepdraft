{
 "note": "Hearthblock furniture tiers (art proposal, 2026-10-20). Not production art: nothing in the game loads these files. Tier 1 is the crude axe-hewn set for the early game; Tier 2 is the carpenter set saved for later. Dimensions are 1:16 cells; one cell is 1/16 world unit. Editable VOX copies are listed per model.",
 "cells_per_block": 16,
 "axes": "X right, Y up, Z toward the front (+Z faces a seated or sleeping dwarf's camera side); ground at Y0. Ranges are [lo, hi) in cells.",
 "operations": {
  "box": "[x0,x1,y0,y1,z0,z1] fill with the role (same as voxel_*.json).",
  "cutbox": "[x0,x1,y0,y1,z0,z1,n] fill, clipping vertical edges by n cells with the diamond rule min(dx)+min(dz) >= n (same as voxel_*.json).",
  "cutbox_x": "As cutbox, but clips the edges that run along X: min(dy)+min(dz) >= n.",
  "cutbox_z": "As cutbox, but clips the edges that run along Z: min(dx)+min(dy) >= n.",
  "paint": "[x0,x1,y0,y1,z0,z1] recolour cells that already exist; adds nothing.",
  "air": "[x0,x1,y0,y1,z0,z1] remove cells (carving).",
  "ring": "[x0,x1,y,z0,z1] one-cell outline of the rectangle on layer y.",
  "mirror_x": "[ops] evaluate the nested ops in an empty model, then merge it and its mirror image (x -> -x-1).",
  "order": "Apply operations in order; later operations overwrite earlier ones.",
  "fingerprint": "cells_sha256 is SHA-256 of the sorted lines \"x,y,z:role\" joined by newlines."
 },
