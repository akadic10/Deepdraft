    "other_version": "{file}: it was made for another version of the game",
    "size_not_numbers": "{file}: its size is not three whole numbers",
    "size_empty": "{file}: its size is empty",
    "too_large": "{file}: it is too large: a blueprint is at most {across} × {tall} × {deep}",
