    "Raised from 0.05 for building (doc 273, 2026-10-26): about four blocks dug for each block built. A playtest setting; revisit in the economy balance pass."
  ],

  "base:terrain:rock:rock01":  { "durability": 3, "drops": [{ "item": "base:resources:stone:rough_stone", "count": 1, "chance": 0.25 }], "material_tags": ["stone", "rock", "stockpile_stone"] },
