extends "res://scripts/tests/BedroomTest.gd"

func _run() -> void:
	create_timer(150).timeout.connect(func(): push_error("Comfort timeout"); quit(1))
	await _setup_crafting_fixture()
	rooms = root.get_node("RoomManager")
	rooms.clear_runtime_state()
	_build_bedroom()
	door = _put("door",Vector3i(63,20,60))
	bed = _put("log_bed",Vector3i(62,20,64))
	lamp = _put("wooden_torch",Vector3i(68,20,64))
	var room := _room_data()
	_expect(float(room.temp_c)>=8 and float(room.temp_c)<14,"ordinary underground room stays cool, not near freezing")
	var unheated: float = room.temp_c
	var heater = _put("hearth",Vector3i(66,20,66))
	room = _room_data()
	_expect(float(room.temp_c)>=16 and float(room.temp_c)<=22,"one hearth heats starter bedroom into comfort range")
	_expect(rooms.comfort_label(room.temp_c)=="Comfortable" and rooms.comfort_label(4)=="Cold","comfort label uses temperature")
	furniture._teardown_installed(heater.installed_id,false)
	_expect(is_equal_approx(_room_data().temp_c,unheated),"removing heater removes heat exactly once")
	var mood = load("res://scripts/components/DwarfMood.gd").new()
	mood.begin_sleep()
	mood.record_sleep(.5,true,4)
	_expect(is_equal_approx(mood.value(),.5),"brief exposure does not create cold thought")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(mood.serialize()))
	mood.restore(saved)
	mood.record_sleep(2.6,true,4)
	_expect(mood.describe().thought.contains("Slept in the cold"),"sustained actual sleep becomes uncomfortable before wake")
	mood.finish_sleep()
	_expect(is_equal_approx(mood.value(),.4),"cold sleep outweighs own-bedroom bonus")
	mood.tick(24)
	_expect(is_equal_approx(mood.value(),.5),"thermal and personal memories expire on game time")
	mood.begin_sleep()
	mood.record_sleep(2,false,29)
	_expect(is_equal_approx(mood.value(),.35),"hot sleep also reduces happiness")
	var blank: Dictionary = mood.serialize()
	for key: String in blank: blank[key] = "" if key == "dining_outcome" else 0.0
	blank.erase("solo_recreation_memory_hours")
	mood.restore(blank)
	mood.record_sleep(3.1,true,20)
	mood.finish_sleep()
	_expect(is_equal_approx(mood.value(),.6),"comfortable personal-room sleep keeps full bonus")
	# Exercise real repeated-stone collection and conservation, not just recipe data.
	furniture._install(BENCH,furniture.get_defs()[BENCH],Vector3i(45,20,42),0)
	drops.spawn_drop(PINE,2,Vector3i(42,21,42))
	drops.spawn_drop(STONE,4,Vector3i(43,21,42))
	var hearths_before := _count("base:resources:furniture:hearth")
	_expect(await _completed(crafting.queue_order("base:recipe:worker:hearth",1)),"worker physically collects all six ingredients and crafts hearth")
	_expect(_count("base:resources:furniture:hearth")==hearths_before+1 and _count(PINE)==0 and _count(STONE)==0,"hearth consumes exactly two timber and four stones")
	for failure: String in failures: push_error(failure)
	print("BEDROOM_COMFORT_OK" if failures.is_empty() else "BEDROOM_COMFORT_FAIL")
	quit(0 if failures.is_empty() else 1)
