extends "res://scripts/tests/ShrubPilotTest.gd"

func _run() -> void:
	create_timer(60).timeout.connect(func(): push_error("Regrowth test timed out"); quit(1))
	for name in ["SaveManager","RoomManager","TaskManager","StockpileManager","WorldClock"]: root.get_node(name).set_process(false)
	clock_node=root.get_node("WorldClock")
	tasks=root.get_node("TaskManager")
	world=root.get_node("WorldData")
	blocks=root.get_node("BlockRegistry")
	root.get_node("WorldGenerator").world_seed=1234
	_build_floor()
	var generator=root.get_node("WorldGenerator")
	generator._cache_block_ids() # Synthetic terrain still needs the production material lookup.
	generator.heightmap.resize(1024*1024); generator.heightmap.fill(20); generator._maps_ready=true
	scene=Node3D.new(); root.add_child(scene); current_scene=scene
	drops=load("res://scripts/systems/ItemDropManager.gd").new(); scene.add_child(drops)
	details=load("res://scripts/systems/SurfaceDetailManager.gd").new(); scene.add_child(details)
	details.set_process(false); details._initialized=true
	_season("summer")
	details.register_record({"id":BLUE,"definition":"base:flora:blueberry_bush","origin":Vector3i(40,20,40),"variant":0,"yaw":0})
	var factory=load("res://scripts/entities/DwarfFactory.gd").new()
	worker=factory.spawn(factory.generate(101,{}),101); scene.add_child(worker)
	worker.position=Vector3(34.5,21,40.5); worker.set_process(false); tasks.register_dwarf(worker)
	await _harvest()
	details._spawn_visual(BLUE)
	_expect(_berry_count("blueberry")==3,"first harvest grants several berries")
	_expect(not details.accepts_tool(BLUE,"harvest_plants"),"freshly picked bush cannot immediately repeat")
	_expect(String(details.get_explorer_data(BLUE).rows[0][1]).contains("Regrowing"),"player sees regrowth state")
	var definition: Dictionary=root.get_node("SurfaceDetailRegistry").get_definition("base:flora:blueberry_bush")
	var crop=load("res://scripts/components/ShrubSeason.gd")
	_advance("summer",2)
	_expect(is_equal_approx(crop.regrow_remaining(definition,details._changes[BLUE]),1.0),"one eligible day regrows half a crop")
	var snapshot: Dictionary=JSON.parse_string(JSON.stringify(details.serialize_state()))
	details.restore_state(snapshot)
	_expect(is_equal_approx(crop.regrow_remaining(definition,details._changes[BLUE]),1.0),"partial regrowth survives save/load")
	_advance("summer",3)
	_expect(details.accepts_tool(BLUE,"harvest_plants"),"same-season crop is ready after two days")
	details._spawn_visual(BLUE)
	_expect(not details._records[BLUE].model_path.contains("picked"),"ripe berries reappear on the plant")
	await _harvest()
	_expect(_berry_count("blueberry")==6,"second in-season harvest grants another crop once")
	_expect(not details._complete_shrub(101,BLUE),"duplicate completion does not reward another crop")
	# Harvest near the end of summer: half the cooldown carries over winter.
	_advance("summer",28)
	await _harvest()
	_advance("autumn",1)
	var remaining: float=crop.regrow_remaining(definition,details._changes[BLUE])
	_expect(is_equal_approx(remaining,1.5),"only final half summer day contributes across noon-to-noon season boundary")
	_advance("winter",20)
	_expect(is_equal_approx(crop.regrow_remaining(definition,details._changes[BLUE]),remaining),"winter contributes no berry regrowth")
	_advance("summer",1,2)
	_expect(not details.accepts_tool(BLUE,"harvest_plants"),"new season cannot reset a partial crop")
	_advance("summer",2,2)
	_expect(details.accepts_tool(BLUE,"harvest_plants"),"remaining eligible day completes regrowth next summer")
	await _harvest()
	_advance("summer",3,2)
	# Use the actual uproot work and relocation owner, rather than changing crop data.
	_expect(details.designate_uproot(BLUE),"picked bush can be uprooted")
	_expect(await _until_working(),"worker reaches bush for uprooting")
	for i in 40: worker._process(.1)
	_expect(details._changes[BLUE].packed,"completed uproot packs the bush")
	remaining=crop.regrow_remaining(definition,details._changes[BLUE])
	_advance("summer",12,2)
	_expect(is_equal_approx(crop.regrow_remaining(definition,details._changes[BLUE]),remaining),"packed bush cannot grow fruit in storage")
	snapshot=JSON.parse_string(JSON.stringify(details.serialize_state()))
	details.restore_state(snapshot)
	var destination:=Vector3i(45,20,46)
	var soil: int=blocks.get_id("base:terrain:surface:grass")
	# Fixture ground uses rock; transplant requires a permitted soil block.
	world.set_block(destination.x,destination.y,destination.z,soil)
	_expect(details.can_plant(BLUE,"base:flora:blueberry_bush",destination),"replant destination is valid")
	if details.can_plant(BLUE,"base:flora:blueberry_bush",destination):
		details.plant_shrub(BLUE,"base:flora:blueberry_bush",destination,1)
		_expect(is_equal_approx(crop.regrow_remaining(definition,details._changes[BLUE]),remaining),"replant keeps credited progress and excludes packed time")
		_advance("summer",13,2)
		_expect(details.accepts_tool(BLUE,"harvest_plants"),"regrowth resumes after replanting")
	for failure in failures: push_error(failure)
	print("SHRUB_REGROWTH_OK: repeat crops, seasonal/packed pauses, save, relocation, visual and reward conservation" if failures.is_empty() else "SHRUB_REGROWTH_FAIL")
	quit(0 if failures.is_empty() else 1)

func _harvest() -> void:
	_expect(details.designate_detail(BLUE,"harvest_plants"),"ripe crop accepts harvest")
	_expect(await _until_working(),"worker reaches normal harvest")
	for i in 40: worker._process(.1)

func _advance(season: String, day: int, year := 1) -> void:
	clock_node.restore_state({"year":year,"season":season,"day":day,"hour":12,"speed":1,"paused":false})
