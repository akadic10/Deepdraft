# Godot 4+ specific ignores
.godot/
/android/

# Exported game builds (regenerable via Project > Export; keep export_presets.cfg)
/build/
/export/
/*.exe
/*.pck
/*.zip

# Python bytecode (tool scripts)
__pycache__/

# Generated test output stays local; reports and review captures can be committed.
/tmp/**/*.log
/tmp/**/*.err

# Isolated Godot test profiles (runtime saves, settings and shader caches)
/tmp/**/appdata/
/tmp/**/localappdata/
/tmp/**/shader_cache/
/tmp/boulder_review/appdata_*/
/tmp/boulder_review/localappdata_*/
