# Godot 4+ specific ignores
.godot/
/android/

# Exported game builds (regenerable via Project > Export; keep export_presets.cfg)
/build/
/export/
/*.exe
/*.pck
/*.zip

# Python bytecode (tool scripts)
__pycache__/

# Local test output, extracted builds, scratch scripts and isolated Godot profiles.
# Copy durable reports/review captures into docs/00_dev_roadmap/concepts/.
# Previously tracked tmp files remain tracked; this prevents new scratch output.
/tmp/
