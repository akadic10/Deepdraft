# Godot 4+ specific ignores
.godot/
/android/

# Exported game builds (regenerable via Project > Export; keep export_presets.cfg)
/build/
/export/
/*.exe
/*.pck
/*.zip

# Python bytecode (tool scripts)
__pycache__/

# Local test output, extracted builds, scratch scripts and isolated Godot profiles.
# Review screenshots and reports stay here; don't copy them into docs/ unless the owner asks.
# Only tmp/.gdignore stays tracked, so Godot never imports scratch output.
/tmp/
